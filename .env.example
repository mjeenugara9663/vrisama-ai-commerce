# Copy to .env.local; NEVER commit credentials.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_SERVICE_ROLE_KEY
APP_URL=http://localhost:3000

# Optional: OpenAI-compatible LLM endpoint; server-only key.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Optional: internal Vrisama-owned n8n workflow webhook (not customer-editable).
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Optional Razorpay TEST-mode credentials and plan IDs; switch to LIVE only after testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_BUSINESS=
RAZORPAY_PLAN_GROWTH=

# Required before production use of public contact forms; blocks lead submission if missing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Random secret used to hash client IPs before storing rate-limit counters (generate: openssl rand -hex 32).
RATE_LIMIT_SALT=

# --- Search insights (optional) ---------------------------------------------------------------
# Shared secret for the daily sync job /api/cron/search-sync (Vercel Cron sends it automatically). openssl rand -hex 32
CRON_SECRET=
# Google Search Console property that covers APP_URL, e.g. https://app.example.com/ or sc-domain:example.com
GSC_SITE_URL=
# Service account added as a (Restricted) user on that property. Paste the private key with \n for newlines.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
